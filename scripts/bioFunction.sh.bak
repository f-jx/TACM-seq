#!/bin/bash
# shell脚本调用的函数
# by f-jx

# 为grep等单线程的命令提供多线程支持
    # [ -e /tmp/fd11 ] || mkfifo /tmp/fd11;exec 9<>/tmp/fd11;rm /tmp/fd11;for ((i=1;i<=20;i++));do echo >&9;done
# awk读取csv：awk -v FPAT='[^,]*|"[^"]*"'
# 函数要考虑几个点：
    # 1 局部变量必须定义好
    # 2 是否需要提前创建目录路径
    # 3 是否应该保存中间文件？循环的源文件如果删除，是否会影响该函数结果？
    # 4 根据什么条件判定跳过该步骤，节省时间
    # 5 for i in `ls *.gz`; 不要直接写 in *.gz; 如果通配符没有扩展，会多出一个*.gz进入循环
    # 6 根据参数判断时需考虑参数是否存在，判断参数是否存在[ ! ${1} ]要写前面，否则会报错
    # 7 注意！：所有带*,?等会被bash扩展的字符或空格的变量，在传入或者使用的时候必须考虑用引号括起来
    # 8 在同一条命令中写入不同参数: echo "XXX#kkk#XXX" | sed 's/#\+[^#]*#\+//g' | bash
    # 9 或者把参数定义成局部变量
    # 10 多个逻辑判断且不带括号时，会把后面的看作整体来执行：aa || bb && cc || dd; 相当于 aa || (bb && (cc || dd))
# 注意多个逻辑运算符串联：true || false && echo ddd 不同于 true || (false && echo ddd)
# 以下代码只能用于普通bash，在slurm脚本中反而会进入/var/xxx下，slurm必须指定工作路径，或者直接到路径下执行
    # cd $(dirname $(readlink -f $0))
    # cd $(dirname $(realpath $0))
    # source $(dirname $(readlink -f $0))/bioFunction.sh.bak

